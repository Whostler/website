# Public site URL used for metadata and canonical references
VITE_SITE_URL=https://example.com

# Contact placeholders (replace with official values)
VITE_CONTACT_EMAIL=contact@example.com

# Optional contact delivery endpoint (e.g. a serverless function or external
# service). Leave empty to use the documented mailto fallback — the form will
# NOT pretend a message was sent. Never put secrets in VITE_ variables; they
# are embedded in the client bundle.
VITE_CONTACT_ENDPOINT=

# Optional social placeholders (empty values hide the links)
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
