# Public site URL used for metadata and canonical references
VITE_SITE_URL=https://whostler.country

# Contact placeholders (replace with official values)
VITE_CONTACT_EMAIL=whostlerservices@google.com

# Contact delivery endpoint (Vercel function in api/contact.ts, deployed with
# the frontend). The form posts the validated JSON payload here and shows
# success only on 2xx. Leave empty to keep the honest mailto fallback (e.g.
# for local `vite dev` without the Vercel CLI).
VITE_CONTACT_ENDPOINT=/api/contact

# Optional social placeholders (empty values hide the links)
VITE_GITHUB_URL=https://github.com/whostler
VITE_LINKEDIN_URL=

# --- Server-side only (Vercel Environment Variables; NEVER VITE_*) ---
# These are used by api/contact.ts at runtime and never enter the client bundle.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives the inquiries
CONTACT_RECIPIENT_EMAIL=whostlerservices@google.com

# Verified Resend sender, e.g. "Whostler Services <contact@whostler.country>".
# When empty, the function falls back to Resend's test sender
# (onboarding@resend.dev), which only works for the account owner's email.
CONTACT_FROM_EMAIL=
